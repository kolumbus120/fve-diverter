# Šablóna. Skopíruj na `secrets.yaml` a doplň reálne hodnoty.
# secrets.yaml je v .gitignore — NIKDY sa necommituje.
wifi_ssid: "<názov WiFi>"
wifi_password: "<heslo WiFi>"
ap_password: "<fallback AP heslo, ľubovoľné>"
api_key: "<vygeneruj: openssl rand -base64 32>"
ota_password: "<ľubovoľné OTA heslo>"
# Solax dongl (lokálne čítanie prebytku) — potrebné až po odkomentovaní regulácie
solax_url: "http://<ip donglu>/"
solax_post_body: "optType=ReadRealTimeData&pwd=<registračné číslo donglu>"
